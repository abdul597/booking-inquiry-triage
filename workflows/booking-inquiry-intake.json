              "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"booking_ref\": {\"type\": [\"string\", \"null\"]},\n    \"route\": {\"type\": [\"string\", \"null\"]},\n    \"original_date\": {\"type\": [\"string\", \"null\"]},\n    \"new_date\": {\"type\": [\"string\", \"null\"]},\n    \"requested_change\": {\"type\": [\"string\", \"null\"]}\n  },\n  \"additionalProperties\": false,\n  \"required\": [\"booking_ref\", \"route\", \"original_date\", \"new_date\", \"requested_change\"]\n}",
              "strict": true
